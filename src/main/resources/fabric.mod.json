{
	"schemaVersion": 1,
	"id": "skyblock_value_alerts",
	"version": "${version}",
	"name": "SkyBlock Value Alerts",
	"description": "Shows a HUD notification and plays a sound whenever you pick up an item worth over 1,000,000 coins on the Hypixel SkyBlock bazaar or auction house.",
	"authors": [
		"Rareuncommon"
	],
	"contact": {
		"sources": "https://github.com/rareuncommon/claude-test"
	},
	"license": "CC0-1.0",
	"icon": "assets/skyblock_value_alerts/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.rareuncommon.skyblockvaluealerts.SkyblockValueAlerts"
		],
		"client": [
			"com.rareuncommon.skyblockvaluealerts.client.SkyblockValueAlertsClient"
		]
	},
	"mixins": [
		{
			"config": "skyblock_value_alerts.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}
